{{#> layout esCuotas=true}}
<main class="container py-3">
	<div class="mb-3">
		<a href="/cuotas" class="link-secondary">Volver a cuotas</a>
		<h1 class="h3 mt-2">Registrar pago</h1>
		<p class="text-secondary">Seleccioná una cuota pendiente e ingresá el importe recibido. Se permiten pagos parciales.</p>
	</div>

	{{#if mensajeError}}
	<div class="alert alert-danger" role="alert">{{mensajeError}}</div>
	{{/if}}

	<section class="card">
		<div class="card-body">
			<form method="post" action="/cuotas/registrar-pago">
				<div class="mb-3">
					<label class="form-label" for="cuotaKey">Alumno y cuota</label>
					<select class="form-select" id="cuotaKey" name="cuotaKey" required {{#unless opcionesPago.length}}disabled{{/unless}}>
						<option value="">Seleccioná una cuota...</option>
						{{#each opcionesPago}}
						<option value="{{this.cuotaKey}}" {{#if this.seleccionada}}selected{{/if}}>{{this.etiqueta}}</option>
						{{/each}}
					</select>
				</div>
				<div class="mb-3">
					<label class="form-label" for="monto">Importe recibido</label>
					<input class="form-control" type="number" id="monto" name="monto" min="0.01" step="0.01" value="{{monto}}" required {{#unless opcionesPago.length}}disabled{{/unless}}>
					<div class="form-text">El importe no puede superar el saldo pendiente de la cuota seleccionada.</div>
				</div>
				<div class="d-flex gap-2">
					<button class="btn btn-primary" type="submit" {{#unless opcionesPago.length}}disabled{{/unless}}>Guardar pago</button>
					<a class="btn btn-outline-secondary" href="/cuotas">Cancelar</a>
				</div>
			</form>
		</div>
	</section>
</main>
{{/layout}}
