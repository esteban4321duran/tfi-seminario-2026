{{#> layout}}
<link href="https://cdn.datatables.net/3.1.3/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<div class="container-fluid">
<section class="row">

<div class="col">
<form method="get">
<label for="anio-consulta" class="form-label">Año consulta</label>
<select class="form-select" aria-label="Select year to query for" name="anio" id="anio-consulta">
{{#each aniosOptions}}
        <option 
                value="{{this.valor}}" 
                {{#if this.esSeleccionado}}
                selected
                {{/if}}
        >
                {{this.valor}}
        </option>
{{/each}}
</select>
        <button type="submit" class="btn btn-primary">Buscar</button>
</form>
</div>
        <div class="col">
                <ul class="list-group list-group-horizontal">
                        <li class="list-group-item fw-bold">Leyenda</li>
                        <li class="list-group-item list-group-item-secondary">Pagado</li>
                        <li class="list-group-item list-group-item-warning">Parcial</li>
                        <li class="list-group-item list-group-item-danger">Pendiente</li>
                </ul>
        </div>
</section>
        <main class="table-responsive row">
                <table id="example" class="table table-striped table-sm">
                        <thead>
                                <tr>
                                        <th>Apellido, Nombre</th>
                                        <th>DNI</th>
                                        {{#each conceptos}}
                                        <th>{{this}}</th>
                                        {{/each}}
                                </tr>
                        </thead>
                        <tbody>
                                {{#each cuentasAlumnos}}
                                {{#with this as |cuentaCorrienteAlumno|}}
                                <tr>
                                        <td>{{cuentaCorrienteAlumno.alumno.apellido}},
                                                {{cuentaCorrienteAlumno.alumno.nombre}}</td>
                                        <td>{{cuentaCorrienteAlumno.alumno.dni}}</td>

                                        {{#each cuentaCorrienteAlumno.conceptos}}
                                        {{#with this as |concepto|}}
                                        {{#unless concepto.vacio}}
                                        {{#if concepto.estadoPagado}}
                                        <td class="table-secondary">
                                                Pagado
                                        </td>
                                        {{/if}}
                                        {{#if concepto.estadoParcial}}
                                        <td class="table-warning">
                                                Falta: {{concepto.importePendiente}}
                                        </td>
                                        {{/if}}
                                        {{#if concepto.estadoPendiente}}
                                        <td class="table-danger">
                                                Falta: {{concepto.importePendiente}}
                                        </td>
                                        {{/if}}
                                        {{/unless}}
                                        {{#if concepto.vacio}}
                                        <td class="table-secondary">
                                                -----
                                        </td>
                                        {{/if}}
                                        {{/with}}
                                        {{/each}}
                                </tr>
                                {{/with}}
                                {{/each}}
                        </tbody>
                </table>
        </main>
</div>
<script src="https://cdn.datatables.net/3.1.3/js/dataTables.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.datatables.net/3.1.3/js/dataTables.bootstrap5.min.js" crossorigin="anonymous"></script>
<script defer>
        new DataTable('#example');
</script>
{{/layout}}
