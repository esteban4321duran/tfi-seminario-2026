<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>DEMO Americana LSA</title>
    <link href="/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <style>
      body {
        margin: 0;
        background: #dfe5eb;
        color: #eaf1ff;
        font-family: "Segoe UI", Tahoma, sans-serif;
      }

      .app-shell {
        display: flex;
        min-height: 100vh;
        background: #dfe5eb;
      }

      .app-sidebar {
        width: 275px;
        position: sticky;
        top: 0;
        align-self: flex-start;
        height: 100vh;
        height: 100dvh;
        overflow-y: auto;
        flex-shrink: 0;
        z-index: 20;
        background: #0d233d;
        border-right: 1px solid rgba(255,255,255,0.08);
        padding: 22px 18px 24px;
        box-sizing: border-box;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 4px 0 30px;
        color: #eaf1ff;
        font-weight: 700;
        font-size: 1.05rem;
      }

      .brand-mark {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: linear-gradient(135deg, #74d0ff, #4e9fe9);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #fff;
        font-size: 1.1rem;
        box-shadow: inset 0 0 0 2px rgba(255,255,255,.12);
      }

      .sidebar-section-label {
        margin: 26px 0 14px;
        padding-left: 4px;
        color: rgba(255,255,255,0.72);
        font-size: 12px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-weight: 700;
      }

      .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .nav-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 6px;
        color: #dfeaf9;
        text-decoration: none;
        font-weight: 500;
        opacity: 0.9;
      }

      .nav-link.active,
      .nav-link:hover {
        background: rgba(111, 178, 255, 0.14);
        opacity: 1;
        text-decoration: none;
        color: #fff;
      }

      .nav-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #dfeaf9;
        display: inline-block;
        opacity: 0.9;
      }

      .app-main {
        flex: 1;
        background: #f1f4f7;
        min-width: 0;
      }

      .app-header {
        display: flex;
        position: sticky;
        top: 0;
        z-index: 10;
        align-items: center;
        justify-content: space-between;
        padding: 20px 28px 18px;
        background: #f6f7f8;
        border-bottom: 1px solid rgba(90, 106, 124, 0.18);
        min-height: 74px;
        transition: transform 180ms ease;
        will-change: transform;
      }

      .app-header.is-hidden {
        transform: translateY(-100%);
      }

      .app-breadcrumb {
        font-size: 14px;
        color: #4b5869;
        font-weight: 500;
      }

      .app-breadcrumb strong {
        color: #1a3149;
        font-weight: 700;
      }

      .admin-pill {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        color: #24384f;
        font-weight: 700;
      }

      .admin-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg, #5db0ff, #3d8ae6);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 700;
        box-shadow: inset 0 0 0 2px rgba(255,255,255,0.25);
      }

      .admin-meta {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 2px;
      }

      .admin-title {
        font-size: 15px;
        color: #1d314a;
        font-weight: 700;
      }

      .admin-subtitle {
        font-size: 12px;
        color: #69788b;
        font-weight: 500;
      }

      .page-content {
        background: #f3f5f7;
        padding: 18px 20px 28px;
      }

      @media (max-width: 900px) {
        .app-shell {
          flex-direction: column;
        }

        .app-sidebar {
          width: 100%;
          position: static;
          height: auto;
          overflow: visible;
          border-right: none;
          border-bottom: 1px solid rgba(255,255,255,0.08);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .app-header {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="app-shell">
      <aside class="app-sidebar">
        <div class="brand">
          <span class="brand-mark">A</span>
          <div>
            <div>AMERICANA</div>
            <div style="font-size: 12px; color: rgba(255,255,255,0.75); font-weight: 500; margin-top: 4px;">Gestión académica</div>
          </div>
        </div>

        <div class="sidebar-section-label">Espacio de trabajo</div>

        <nav class="sidebar-nav" aria-label="Navegación principal">
          <a class="nav-link" href="/"><span class="nav-dot"></span>Resumen</a>
          <a class="nav-link {{#if esCursos}}active{{/if}}" href="/administrar-cursos"><span class="nav-dot"></span>Cursos</a>
          <a class="nav-link {{#if esInscripciones}}active{{/if}}" href="/inscribir-alumno"><span class="nav-dot"></span>Inscripciones</a>
          <a class="nav-link {{#if esCuotas}}active{{/if}}" href="/cuotas"><span class="nav-dot"></span>Cuotas</a>
        </nav>
      </aside>

      <main class="app-main">
        <header class="app-header">
          <div class="app-breadcrumb"><strong>Americana</strong> / <span style="color:#5d6b7d;">{{#if esCuotas}}Cuotas{{else}}{{#if esInscripciones}}Inscripciones{{else}}Cursos{{/if}}{{/if}}</span></div>
          <div class="admin-pill">
            <span class="admin-avatar">AD</span>
            <span class="admin-meta">
              <span class="admin-title">Administración</span>
              <span class="admin-subtitle">Panel de prueba</span>
            </span>
          </div>
        </header>

        <div class="page-content">
          {{> @partial-block }}
        </div>
      </main>
    </div>

    <script>
      (() => {
        const header = document.querySelector('.app-header');
        let lastScrollY = window.scrollY;
        let updateScheduled = false;
        let idleTimer;

        const updateHeader = () => {
          const currentScrollY = window.scrollY;
          if (currentScrollY <= header.offsetHeight || currentScrollY < lastScrollY - 2) {
            header.classList.remove('is-hidden');
          } else if (currentScrollY > lastScrollY + 2) {
            header.classList.add('is-hidden');
          }
          lastScrollY = currentScrollY;
          updateScheduled = false;
        };

        window.addEventListener('scroll', () => {
          window.clearTimeout(idleTimer);
          idleTimer = window.setTimeout(() => header.classList.remove('is-hidden'), 700);
          if (!updateScheduled) {
            window.requestAnimationFrame(updateHeader);
            updateScheduled = true;
          }
        }, { passive: true });
      })();
    </script>
    <script src="/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  </body>
</html>
